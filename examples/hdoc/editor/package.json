{
  "name": "@officecli/hcd-reference-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist-embed",
    "src/public.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./react": {
      "types": "./src/public.d.ts",
      "import": "./dist-embed/hcd-editor.js"
    },
    "./style.css": "./dist-embed/hcd-editor.css"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "sidecar": "tsx sidecar.ts",
    "dev:agent": "tsx scripts/start-agent-demo.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.embed.config.ts",
    "test:workspace": "playwright test",
    "test:provider": "node scripts/verify-provider.mjs",
    "test:word-review-anchors": "tsx scripts/verify-word-review-anchors.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@hocuspocus/transformer": "4.7.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/y-tiptap": "3.0.9",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-drawing": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "highlight.js": "11.11.1",
    "lucide-react": "^1.73.0",
    "pdfjs-dist": "^6.3.289",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "7.0.0",
    "yjs": "13.6.27"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "ajv": "^8.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.11",
    "zod": "4.6.7"
  }
}
