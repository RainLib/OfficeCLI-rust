{
  "name": "@officecli/hcd-reference-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist-embed",
    "src/public.d.ts",
    "src/commands/types.ts",
    "src/extensionTypes.ts",
    "src/customMarkTypes.ts",
    "src/extensionPortable.ts",
    "src/ai/index.ts",
    "src/ai/types.ts",
    "src/ai/core.ts",
    "src/ai/http.ts",
    "src/ai/autocomplete.ts",
    "src/inline-containers.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./react": {
      "types": "./src/public.d.ts",
      "import": "./dist-embed/hcd-editor.js"
    },
    "./ai": {
      "types": "./src/ai/index.ts",
      "import": "./dist-embed/ai.js"
    },
    "./style.css": "./dist-embed/hcd-editor.css",
    "./inline-containers": {
      "types": "./src/inline-containers.d.ts",
      "import": "./dist-embed/inline-containers.js"
    }
  },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "dev": "vite --host 127.0.0.1",
    "sidecar": "tsx sidecar.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.embed.config.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.7.0",
    "@hocuspocus/server": "4.7.0",
    "@hocuspocus/transformer": "4.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-collaboration": "3.31.3",
    "@tiptap/extension-collaboration-caret": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/preset-sheets-drawing": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "lib0": "0.2.117",
    "yjs": "13.6.27"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "6.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.11"
  }
