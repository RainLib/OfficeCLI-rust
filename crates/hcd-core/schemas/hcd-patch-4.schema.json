{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:4",
  "title": "HCD semantic block patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/4" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "oneOf": [
        { "$ref": "#/$defs/insert" }, { "$ref": "#/$defs/delete" },
        { "$ref": "#/$defs/move" }, { "$ref": "#/$defs/replace" },
        { "$ref": "#/$defs/tableEdit" }, { "$ref": "#/$defs/tableInsert" }, { "$ref": "#/$defs/tableCellActivate" }
      ] }
    }
  },
  "$defs": {
    "nodeId": { "type": "string", "pattern": "^n_[0-9a-f]{32}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "precondition": {
      "type": "object", "additionalProperties": false, "required": ["blockHash"],
      "properties": { "blockHash": { "$ref": "#/$defs/hash" } }
    },
    "inline": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 1048576 },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "bold": { "type": "boolean" }, "italic": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 2048, "pattern": "^(https?://|mailto:)" },
        "format": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "underline": { "type": "boolean" },
            "font": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\p{L}\\p{N} _-]+$" },
            "sizeHalfPoints": { "type": "integer", "minimum": 2, "maximum": 512 },
            "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" }
          }
        }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["kind", "inlines"],
      "properties": {
        "kind": { "enum": ["paragraph", "heading", "list_item"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 6 },
        "alignment": { "enum": ["left", "center", "right", "justify"] },
        "inlines": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "insert": {
      "type": "object", "additionalProperties": false, "required": ["op", "block", "afterBlockId"],
      "properties": { "op": { "const": "block.insert" }, "afterBlockId": { "oneOf": [ { "$ref": "#/$defs/nodeId" }, { "type": "null" } ] }, "block": { "$ref": "#/$defs/block" } }
    },
    "tableText": {
      "type": "object", "additionalProperties": false, "required": ["kind", "inlines"],
      "properties": {
        "kind": { "const": "opaque" },
        "inlines": { "type": "array", "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "delete": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "precondition"],
      "properties": { "op": { "const": "block.delete" }, "blockId": { "$ref": "#/$defs/nodeId" }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "move": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "afterBlockId", "precondition"],
      "properties": { "op": { "const": "block.move" }, "blockId": { "$ref": "#/$defs/nodeId" }, "afterBlockId": { "oneOf": [ { "$ref": "#/$defs/nodeId" }, { "type": "null" } ] }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "tableEdit": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "action", "index", "precondition"],
      "properties": { "op": { "const": "table.edit" }, "blockId": { "$ref": "#/$defs/nodeId" }, "action": { "enum": ["insertRow", "deleteRow", "insertColumn", "deleteColumn"] }, "index": { "type": "integer", "minimum": 0, "maximum": 256 }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "tableInsert": {
      "type": "object", "additionalProperties": false, "required": ["op", "afterBlockId", "rows", "columns"],
      "properties": { "op": { "const": "table.insert" }, "afterBlockId": { "oneOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }] }, "rows": { "type": "integer", "minimum": 1, "maximum": 256 }, "columns": { "type": "integer", "minimum": 1, "maximum": 64 } }
    },
    "tableCellActivate": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "row", "column", "precondition"],
      "properties": { "op": { "const": "table.cell.activate" }, "blockId": { "$ref": "#/$defs/nodeId" }, "row": { "type": "integer", "minimum": 0, "maximum": 255 }, "column": { "type": "integer", "minimum": 0, "maximum": 63 }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "replace": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "block", "precondition"],
      "properties": { "op": { "const": "block.replace" }, "blockId": { "$ref": "#/$defs/nodeId" }, "block": { "oneOf": [{ "$ref": "#/$defs/block" }, { "$ref": "#/$defs/tableText" }] }, "precondition": { "$ref": "#/$defs/precondition" } }
    }
  }
}
