{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:4",
  "title": "HCD semantic block patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/4" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": { "oneOf": [
        { "$ref": "#/$defs/insert" }, { "$ref": "#/$defs/delete" },
        { "$ref": "#/$defs/move" }, { "$ref": "#/$defs/replace" },
        { "$ref": "#/$defs/tableInsert" }, { "$ref": "#/$defs/tableEdit" },
        { "$ref": "#/$defs/tableDelete" }, { "$ref": "#/$defs/tableRestore" }
      ] }
    }
  },
  "$defs": {
    "nodeId": { "type": "string", "pattern": "^n_[0-9a-f]{32}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "precondition": {
      "type": "object", "additionalProperties": false, "required": ["blockHash"],
      "properties": { "blockHash": { "$ref": "#/$defs/hash" } }
    },
    "inline": {
      "type": "object", "additionalProperties": false, "required": ["text"],
      "properties": {
        "text": { "type": "string", "maxLength": 1048576 },
        "bold": { "type": "boolean" }, "italic": { "type": "boolean" },
        "link": { "type": "string", "maxLength": 2048, "pattern": "^([Hh][Tt][Tt][Pp][Ss]?://|[Mm][Aa][Ii][Ll][Tt][Oo]:|[Tt][Ee][Ll]:|#)", "description": "HTTP(S), mailto, tel or a fragment. Runtime also rejects control characters and backslashes and enforces a 2048 UTF-8 byte limit." }
      }
    },
    "block": {
      "type": "object", "additionalProperties": false, "required": ["kind", "inlines"],
      "properties": {
        "kind": { "enum": ["paragraph", "heading", "list_item"] },
        "level": { "type": "integer", "minimum": 0, "maximum": 6 },
        "font": { "$ref": "#/$defs/blockFont" },
        "inlines": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/inline" } }
      }
    },
    "mappedTableInline": {
      "type": "object", "additionalProperties": false, "required": ["nodeId", "text"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "text": { "type": "string", "maxLength": 1048576 },
        "bold": { "type": "boolean" }, "italic": { "type": "boolean" },
        "link": { "type": ["string", "null"], "maxLength": 2048 }
      }
    },
    "mappedTableBlock": {
      "description": "Text-only replacement of an existing opaque table. Server requires exactly the original run identities, order, marks, level and font; only editableTextNodeIds may change text. Table structure remains protected.",
      "type": "object", "additionalProperties": false, "required": ["kind", "inlines"],
      "properties": {
        "kind": { "const": "opaque" },
        "level": { "type": ["integer", "null"], "minimum": 0, "maximum": 6 },
        "font": { "$ref": "#/$defs/blockFont" },
        "inlines": { "type": "array", "items": { "$ref": "#/$defs/mappedTableInline" } }
      }
    },
    "blockFont": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Script faces pinned on the whole block. The same three slots a text.font operation takes, with the same limits the server enforces.",
      "properties": {
        "latin": { "$ref": "#/$defs/fontFamily" },
        "eastAsia": { "$ref": "#/$defs/fontFamily" },
        "bidi": { "$ref": "#/$defs/fontFamily" }
      }
    },
    "fontFamily": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "description": "One font family. maxLength counts characters; the server caps the value at 128 bytes.",
      "pattern": "^[^<>\"';:&\\x00-\\x1F\\x7F]+$"
    },
    "tableDelete": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "precondition"],
      "properties": { "op": { "const": "table.delete" }, "blockId": { "$ref": "#/$defs/nodeId" }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "tableRestore": {
      "description": "Restore one canonical table from immutable history. A null blockHash requires the table to be absent; otherwise requires its exact current hash. Keeps other blocks and never accepts client HTML.",
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "sourceRevision", "afterBlockId", "precondition"],
      "properties": {
        "op": { "const": "table.restore" }, "blockId": { "$ref": "#/$defs/nodeId" },
        "sourceRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "afterBlockId": { "oneOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }] },
        "precondition": { "type": "object", "additionalProperties": false, "required": ["blockHash"], "properties": { "blockHash": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] } } }
      }
    },
    "tableInsert": {
      "description": "Insert an empty table in a rich semantic body. At most 10000 logical cells.",
      "type": "object", "additionalProperties": false, "required": ["op", "afterBlockId", "rows", "columns"],
      "properties": {
        "op": { "const": "table.insert" },
        "afterBlockId": { "oneOf": [{ "$ref": "#/$defs/nodeId" }, { "type": "null" }] },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "columns": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "tableEdit": {
      "description": "Guarded row/column insertion or deletion. tableIndex is zero-based DFS table order within the block. index is a zero-based logical grid boundary for insertion or position for deletion. Merges adjust; the last row/column cannot be removed. Fragmented or incomplete grids reject atomically.",
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "tableIndex", "action", "index", "precondition"],
      "properties": {
        "op": { "const": "table.edit" }, "blockId": { "$ref": "#/$defs/nodeId" },
        "tableIndex": { "type": "integer", "minimum": 0 },
        "action": { "enum": ["insertRow", "deleteRow", "insertColumn", "deleteColumn"] },
        "index": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "precondition": { "$ref": "#/$defs/precondition" }
      }
    },
    "insert": {
      "type": "object", "additionalProperties": false, "required": ["op", "block", "afterBlockId"],
      "properties": { "op": { "const": "block.insert" }, "afterBlockId": { "oneOf": [ { "$ref": "#/$defs/nodeId" }, { "type": "null" } ] }, "block": { "$ref": "#/$defs/block" } }
    },
    "delete": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "precondition"],
      "properties": { "op": { "const": "block.delete" }, "blockId": { "$ref": "#/$defs/nodeId" }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "move": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "afterBlockId", "precondition"],
      "properties": { "op": { "const": "block.move" }, "blockId": { "$ref": "#/$defs/nodeId" }, "afterBlockId": { "oneOf": [ { "$ref": "#/$defs/nodeId" }, { "type": "null" } ] }, "precondition": { "$ref": "#/$defs/precondition" } }
    },
    "replace": {
      "type": "object", "additionalProperties": false, "required": ["op", "blockId", "block", "precondition"],
      "properties": { "op": { "const": "block.replace" }, "blockId": { "$ref": "#/$defs/nodeId" }, "block": { "oneOf": [{ "$ref": "#/$defs/block" }, { "$ref": "#/$defs/mappedTableBlock" }] }, "precondition": { "$ref": "#/$defs/precondition" } }
    }
  }
}
