{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:51",
  "title": "HTML Canonical Document XLSX AutoFilter change",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/51" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string" } },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "sheetId", "filter"],
        "properties": {
          "op": { "const": "xlsx.auto-filter.set" },
          "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
          "filter": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["startRow", "endRow", "startColumn", "endColumn", "column", "query"],
                "properties": {
                  "startRow": { "type": "integer", "minimum": 1, "maximum": 1048575 },
                  "endRow": { "type": "integer", "minimum": 2, "maximum": 1048576 },
                  "startColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
                  "endColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
                  "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
                  "query": { "type": "string", "minLength": 1, "maxLength": 253 },
                  "additionalCriteria": {
                    "type": "array", "maxItems": 99,
                    "items": { "$ref": "#/$defs/gridFilterCriterion" }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "gridFilterCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "query"],
      "properties": {
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "query": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    }
  }
}
