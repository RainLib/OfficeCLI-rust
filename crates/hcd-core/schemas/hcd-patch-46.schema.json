{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:46",
  "title": "HTML Canonical Document PPTX shape alignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/46" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string" } },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "nodeId", "align", "precondition"],
        "properties": {
          "op": { "const": "pptx.shape.align" },
          "nodeId": {
            "type": "string",
            "pattern": "^n_[0-9a-f]{32}$"
          },
          "align": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "horizontal": { "enum": ["left", "center", "right", "justify", "distributed"] },
              "vertical": { "enum": ["top", "center", "bottom"] }
            }
          },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeHash"],
            "properties": {
              "nodeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
