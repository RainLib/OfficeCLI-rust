{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:25",
  "title": "HTML Canonical Document XLSX grid selection shift",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/25" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string" } },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "sheetId", "axis", "action", "start", "count"],
        "properties": {
          "op": { "const": "xlsx.grid.range" },
          "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
          "axis": { "enum": ["row", "column"] },
          "action": { "enum": ["insert", "delete"] },
          "start": { "type": "integer", "minimum": 1, "maximum": 1048576 },
          "count": { "type": "integer", "minimum": 2, "maximum": 100 }
        }
      }
    }
  }
}
