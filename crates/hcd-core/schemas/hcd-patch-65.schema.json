{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:65",
  "title": "HTML Canonical Document atomic rich spreadsheet literal restoration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "patchId",
    "baseRevision",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hcd-patch/65"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "patchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "actor": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 262144
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/textSplice"
          },
          {
            "$ref": "#/$defs/xlsxNumberSet"
          },
          {
            "$ref": "#/$defs/xlsxCellClear"
          },
          {
            "$ref": "#/$defs/xlsxRichTextSet"
          }
        ]
      },
      "contains": {
        "$ref": "#/$defs/xlsxRichTextSet"
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^n_[0-9a-f]{32}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "textSplice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "start",
        "deleteCount",
        "insertText",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "text.splice"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeId"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "deleteCount": {
          "type": "integer",
          "minimum": 0
        },
        "insertText": {
          "type": "string",
          "maxLength": 2097152
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeHash"
          ],
          "properties": {
            "nodeHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "xlsxNumberSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "sheetId",
        "value",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "xlsx.number.set"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeId"
        },
        "sheetId": {
          "type": "string",
          "pattern": "^s_[0-9a-f]{32}$"
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeHash"
          ],
          "properties": {
            "nodeHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9+\\-.eE]+$"
        }
      }
    },
    "xlsxCellClear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "sheetId",
        "createdRevision",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "xlsx.cell.clear"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeId"
        },
        "sheetId": {
          "type": "string",
          "pattern": "^s_[0-9a-f]{32}$"
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeHash"
          ],
          "properties": {
            "nodeHash": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "createdRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "xlsxRichTextSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "runs",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "xlsx.richText.set"
        },
        "nodeId": {
          "type": "string",
          "pattern": "^n_[0-9a-f]{32}$"
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "properties"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 32767
              },
              "properties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rFont": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "charset": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "family": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "b": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "i": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "strike": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "outline": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "shadow": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "condense": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "extend": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "color": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "rgb": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "indexed": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "auto": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "theme": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "tint": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "sz": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "u": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "vertAlign": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  },
                  "scheme": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "val": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "precondition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodeHash"
          ],
          "properties": {
            "nodeHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  }
}
