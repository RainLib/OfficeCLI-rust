{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:14",
  "title": "HTML Canonical Document patch batch with XLSX middle row deletion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/14" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "minLength": 1, "maxLength": 256 },
      "additionalProperties": { "type": "string", "maxLength": 65536 }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "minLength": 1, "maxLength": 256 },
      "additionalProperties": { "type": "string", "maxLength": 262144 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/textSplice" },
          { "$ref": "#/$defs/xlsxMerge" },
          { "$ref": "#/$defs/xlsxUnmerge" },
          { "$ref": "#/$defs/xlsxCellSet" },
          { "$ref": "#/$defs/xlsxRowAppend" },
          { "$ref": "#/$defs/xlsxRowInsert" },
          { "$ref": "#/$defs/xlsxRowDelete" },
          { "$ref": "#/$defs/xlsxColumnInsert" },
          { "$ref": "#/$defs/xlsxRowRemoveLast" },
          { "$ref": "#/$defs/xlsxColumnWidth" },
          { "$ref": "#/$defs/nodeStyle" },
          { "$ref": "#/$defs/imageReplace" },
          { "$ref": "#/$defs/imageGeometry" },
          { "$ref": "#/$defs/annotationUpsert" },
          { "$ref": "#/$defs/annotationRemove" }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nodeId": { "type": "string", "pattern": "^n_[0-9a-f]{32}$" },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeHash"],
      "properties": { "nodeHash": { "$ref": "#/$defs/sha256" } }
    },
    "visualPrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visualHash"],
      "properties": { "visualHash": { "$ref": "#/$defs/sha256" } }
    },
    "textSplice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "start", "deleteCount", "insertText", "precondition"],
      "properties": {
        "op": { "const": "text.splice" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "start": { "type": "integer", "minimum": 0 },
        "deleteCount": { "type": "integer", "minimum": 0 },
        "insertText": { "type": "string", "maxLength": 2097152 },
        "precondition": { "$ref": "#/$defs/precondition" }
      }
    },
    "pdfTextInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "page", "xPt", "yPt", "widthPt", "heightPt", "fontSizePt", "text"],
      "properties": {
        "op": { "const": "pdf.text.insert" },
        "page": { "type": "integer", "minimum": 1 },
        "xPt": { "type": "number", "minimum": 0, "maximum": 14400 },
        "yPt": { "type": "number", "minimum": 0, "maximum": 14400 },
        "widthPt": { "type": "number", "exclusiveMinimum": 0, "maximum": 14400 },
        "heightPt": { "type": "number", "exclusiveMinimum": 0, "maximum": 14400 },
        "fontSizePt": { "type": "number", "minimum": 1, "maximum": 256 },
        "text": { "type": "string", "maxLength": 10000 }
      }
    },
    "xlsxMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "sheetId", "startRow", "startColumn", "endRow", "endColumn", "precondition"],
      "properties": {
        "op": { "const": "xlsx.merge" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "startRow": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "startColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "endRow": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "endColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "precondition": { "$ref": "#/$defs/precondition" }
      }
    },
    "xlsxUnmerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "sheetId", "startRow", "startColumn", "endRow", "endColumn", "precondition"],
      "properties": {
        "op": { "const": "xlsx.unmerge" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "startRow": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "startColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "endRow": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "endColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "precondition": { "$ref": "#/$defs/precondition" }
      }
    },
    "xlsxCellSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "row", "column", "text"],
      "properties": {
        "op": { "const": "xlsx.cell.set" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "row": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "text": { "type": "string", "minLength": 1, "maxLength": 32767 }
      }
    },
    "xlsxRowAppend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "afterRow"],
      "properties": {
        "op": { "const": "xlsx.row.append" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "afterRow": { "type": "integer", "minimum": 1, "maximum": 1048575 }
      }
    },
    "xlsxRowInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "beforeRow"],
      "properties": {
        "op": { "const": "xlsx.row.insert" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "beforeRow": { "type": "integer", "minimum": 1, "maximum": 1048575 }
      }
    },
    "xlsxColumnInsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "beforeColumn"],
      "properties": {
        "op": { "const": "xlsx.column.insert" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "beforeColumn": { "type": "integer", "minimum": 1, "maximum": 16383 }
      }
    },
    "xlsxRowDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "row"],
      "properties": {
        "op": { "const": "xlsx.row.delete" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "row": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "xlsxRowRemoveLast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "row"],
      "properties": {
        "op": { "const": "xlsx.row.remove-last" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "row": { "type": "integer", "minimum": 2, "maximum": 1048576 }
      }
    },
    "xlsxColumnWidth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "sheetId", "column", "widthChars"],
      "properties": {
        "op": { "const": "xlsx.column.width" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "widthChars": { "type": "number", "minimum": 1, "maximum": 255, "multipleOf": 0.01 }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
    "border": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "widthPt", "style"],
      "properties": {
        "color": { "$ref": "#/$defs/color" },
        "widthPt": { "type": "number", "exclusiveMinimum": 0, "maximum": 12 },
        "style": { "enum": ["solid", "dashed", "dotted", "double"] }
      }
    },
    "nodeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "style", "precondition"],
      "properties": {
        "op": { "const": "node.style" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "textColor": { "$ref": "#/$defs/color" },
            "backgroundColor": { "$ref": "#/$defs/color" },
            "border": { "$ref": "#/$defs/border" }
          }
        },
        "precondition": { "$ref": "#/$defs/precondition" }
      }
    },
    "imageReplace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "assetHash", "precondition"],
      "properties": {
        "op": { "const": "image.replace" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "assetHash": { "$ref": "#/$defs/sha256" },
        "precondition": { "$ref": "#/$defs/visualPrecondition" }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "unit"],
      "properties": {
        "x": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
        "y": { "type": "number", "minimum": -1000000000000, "maximum": 1000000000000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000000000 },
        "unit": { "enum": ["emu", "pt"] }
      }
    },
    "imageGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "nodeId", "geometry", "precondition"],
      "properties": {
        "op": { "const": "image.geometry" },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "precondition": { "$ref": "#/$defs/visualPrecondition" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotationId", "nodeId", "start", "end", "kind", "ignored"],
      "properties": {
        "annotationId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "nodeId": { "$ref": "#/$defs/nodeId" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "ruleId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "ignored": { "type": "boolean" }
      }
    },
    "annotationUpsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "annotation"],
      "properties": {
        "op": { "const": "annotation.upsert" },
        "annotation": { "$ref": "#/$defs/annotation" }
      }
    },
    "annotationRemove": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "annotationId"],
      "properties": {
        "op": { "const": "annotation.remove" },
        "annotationId": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
