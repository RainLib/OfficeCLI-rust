{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:56",
  "title": "HTML Canonical Document worksheet charts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "patchId",
    "baseRevision",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hcd-patch/56"
    },
    "documentId": {
      "$ref": "#/$defs/identifier"
    },
    "patchId": {
      "$ref": "#/$defs/identifier"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "actor": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "string"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/chartSet"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "chartRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startRow",
        "endRow",
        "startColumn",
        "endColumn"
      ],
      "properties": {
        "startRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "endRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "chartConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "range",
        "anchorRow",
        "anchorColumn"
      ],
      "properties": {
        "kind": {
          "enum": [
            "column",
            "bar",
            "line",
            "pie"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "range": {
          "$ref": "#/$defs/chartRange"
        },
        "anchorRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "anchorColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "chartSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "sheetId",
        "chartId",
        "config"
      ],
      "properties": {
        "op": {
          "const": "xlsx.chart.set"
        },
        "sheetId": {
          "$ref": "#/$defs/identifier"
        },
        "chartId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "config": {
          "anyOf": [
            {
              "$ref": "#/$defs/chartConfig"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
