{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:17",
  "title": "HTML Canonical Document patch batch with PPTX shape geometry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "patchId",
    "baseRevision",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hcd-patch/17"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "patchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "actor": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 65536
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 262144
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/textSplice"
          },
          {
            "$ref": "#/$defs/pptxShapeGeometry"
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^n_[0-9a-f]{32}$"
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeHash"
      ],
      "properties": {
        "nodeHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "textSplice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "start",
        "deleteCount",
        "insertText",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "text.splice"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeId"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "deleteCount": {
          "type": "integer",
          "minimum": 0
        },
        "insertText": {
          "type": "string",
          "maxLength": 2097152
        },
        "precondition": {
          "$ref": "#/$defs/precondition"
        }
      }
    },
    "pptxGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xEmu",
        "yEmu",
        "widthEmu",
        "heightEmu"
      ],
      "properties": {
        "xEmu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "yEmu": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "widthEmu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "heightEmu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        }
      }
    },
    "pptxShapePrecondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeHash",
        "geometry"
      ],
      "properties": {
        "nodeHash": {
          "$ref": "#/$defs/sha256"
        },
        "geometry": {
          "$ref": "#/$defs/pptxGeometry"
        }
      }
    },
    "pptxShapeGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "nodeId",
        "geometry",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "pptx.shape.geometry"
        },
        "nodeId": {
          "$ref": "#/$defs/nodeId"
        },
        "geometry": {
          "$ref": "#/$defs/pptxGeometry"
        },
        "precondition": {
          "$ref": "#/$defs/pptxShapePrecondition"
        }
      }
    }
  }
}
