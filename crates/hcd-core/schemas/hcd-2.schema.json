{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd:2",
  "title": "HTML Canonical Document manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "storageCodec",
    "documentId",
    "profile",
    "revision",
    "source",
    "rootHash",
    "annotationRootHash",
    "indexPrefix",
    "indexPageCount",
    "chunkCount",
    "stylesHref",
    "capabilities",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "const": "hcd/2"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "profile": {
      "enum": [
        "semantic-flow",
        "grid",
        "slide-canvas",
        "fixed-layout",
        "canvas"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "rootHash": {
      "$ref": "#/$defs/sha256"
    },
    "annotationRootHash": {
      "$ref": "#/$defs/sha256"
    },
    "annotationHref": {
      "type": "string",
      "pattern": "^annotations/sha256/[0-9a-f]{64}\\.json(\\.gz)?$"
    },
    "indexPrefix": {
      "type": "string",
      "pattern": "^indexes/rev-[0-9]{20}$"
    },
    "indexPageCount": {
      "type": "integer",
      "minimum": 0
    },
    "chunkCount": {
      "type": "integer",
      "minimum": 0
    },
    "stylesHref": {
      "anyOf": [
        {
          "const": "styles.css"
        },
        {
          "type": "string",
          "pattern": "^styles/[A-Za-z0-9._-]+\\.css$"
        }
      ]
    },
    "themeRevisionId": {
      "$ref": "#/$defs/sha256"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "fidelity": {
      "$ref": "#/$defs/fidelityReport"
    },
    "state": {
      "const": "COMPLETE"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fidelityWarning"
      }
    },
    "storageCodec": {
      "enum": [
        "none",
        "gzip"
      ]
    },
    "indexRootHref": {
      "type": "string",
      "pattern": "^indexes/nodes/sha256/[0-9a-f]{64}\\.json(\\.gz)?$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "format": {
          "enum": [
            "docx",
            "xlsx",
            "pptx",
            "pdf",
            "html",
            "md",
            "txt",
            "png",
            "jpg",
            "jpeg",
            "webp",
            "excalidraw"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textPatch",
        "annotations",
        "structurePatch",
        "stylePatch",
        "exactPagination"
      ],
      "properties": {
        "textPatch": {
          "const": true
        },
        "annotations": {
          "const": true
        },
        "structurePatch": {
          "const": false
        },
        "stylePatch": {
          "const": false
        },
        "exactPagination": {
          "const": false
        }
      }
    },
    "chunkDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "chunkId",
        "region",
        "htmlHref",
        "htmlHash",
        "mapHref",
        "mapHash",
        "byteLength",
        "blockCount",
        "nodeCount",
        "textChars",
        "nodeBloom",
        "continuation"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "chunkId": {
          "type": "string",
          "pattern": "^c_[0-9a-f]{32}$"
        },
        "region": {
          "enum": [
            "body",
            "header",
            "footer",
            "footnote",
            "endnote",
            "comment",
            "sheet",
            "slide",
            "note",
            "page",
            "canvas"
          ]
        },
        "htmlHref": {
          "type": "string",
          "pattern": "^chunks/sha256/[0-9a-f]{64}\\.html(\\.gz)?$"
        },
        "htmlHash": {
          "$ref": "#/$defs/sha256"
        },
        "mapHref": {
          "type": "string",
          "pattern": "^maps/sha256/[0-9a-f]{64}\\.json(\\.gz)?$"
        },
        "mapHash": {
          "$ref": "#/$defs/sha256"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "blockCount": {
          "type": "integer",
          "minimum": 1
        },
        "nodeCount": {
          "type": "integer",
          "minimum": 0
        },
        "textChars": {
          "type": "integer",
          "minimum": 0
        },
        "nodeBloom": {
          "$ref": "#/$defs/sha256"
        },
        "firstNodeId": {
          "type": "string",
          "pattern": "^n_[0-9a-f]{32}$"
        },
        "lastNodeId": {
          "type": "string",
          "pattern": "^n_[0-9a-f]{32}$"
        },
        "continuation": {
          "type": "boolean"
        },
        "grid": {
          "$ref": "#/$defs/gridChunkAddress"
        },
        "pdfLayout": {
          "$ref": "#/$defs/pdfPageLayout"
        }
      }
    },
    "pdfPageLayout": {
      "type": "array", "minItems": 1, "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rotation"],
        "properties": {
          "sourcePage": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "rotation": { "enum": [0, 90, 180, 270] }
        }
      }
    },
    "gridChunkAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetId",
        "sheetName",
        "sheetIndex",
        "sheetState",
        "kind"
      ],
      "properties": {
        "sheetId": {
          "type": "string",
          "pattern": "^s_[0-9a-f]{32}$"
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "sheetIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sheetState": {
          "enum": [
            "visible",
            "hidden",
            "veryHidden"
          ]
        },
        "kind": {
          "enum": [
            "cells",
            "picture",
            "chart"
          ]
        },
        "rowStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "rowEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "columnStart": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "columnEnd": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "defaultColumnWidthEmu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "defaultRowHeightEmu": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "sheetPart": {
          "type": "string",
          "pattern": "^xl/(worksheets|chartsheets)/[^/]+\\.xml$"
        },
        "autoFilter": { "$ref": "#/$defs/gridAutoFilter" },
        "charts": { "type": "array", "items": { "$ref": "#/$defs/worksheetChart" } },
        "conditions": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/worksheetCondition" } },
        "pivots": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/worksheetPivot" } }
      }
    },
    "worksheetPivot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "config": {
          "$ref": "#/$defs/pivotConfig"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceRevision",
            "sourceConfig",
            "report"
          ],
          "properties": {
            "sourceRevision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "sourceConfig": {
              "$ref": "#/$defs/pivotConfig"
            },
            "report": {
              "$ref": "#/$defs/pivotReport"
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "part",
            "range"
          ],
          "properties": {
            "part": {
              "type": "string",
              "maxLength": 512
            },
            "range": {
              "$ref": "#/$defs/chartRange"
            }
          }
        },
        "removed": {
          "type": "boolean"
        }
      }
    },
    "pivotConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sourceSheetId",
        "sourceRange",
        "anchorRow",
        "anchorColumn",
        "rows",
        "columns",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sourceSheetId": {
          "type": "string",
          "pattern": "^s_[0-9a-f]{32}$"
        },
        "sourceRange": {
          "$ref": "#/$defs/chartRange"
        },
        "anchorRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "anchorColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "rows": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "columns": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "aggregate"
            ],
            "properties": {
              "field": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "aggregate": {
                "enum": [
                  "sum",
                  "count",
                  "average",
                  "min",
                  "max"
                ]
              }
            }
          }
        }
      }
    },
    "pivotReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headerRows",
        "labelColumns",
        "cells"
      ],
      "properties": {
        "headerRows": {
          "type": "integer",
          "minimum": 0
        },
        "labelColumns": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "$ref": "#/$defs/pivotCell"
            }
          }
        }
      }
    },
    "pivotCell": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "blank"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "enum": [
                "text",
                "number",
                "error"
              ]
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "worksheetCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "config"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "config": { "$ref": "#/$defs/worksheetConditionConfig" },
        "sourcePriority": { "type": "integer", "minimum": 1 },
        "edited": { "type": "boolean" },
        "removed": { "type": "boolean" }
      }
    },
    "worksheetConditionConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["range", "operator", "values"],
      "properties": {
        "range": { "$ref": "#/$defs/chartRange" },
        "operator": { "enum": ["greaterThan", "greaterThanOrEqual", "lessThan", "lessThanOrEqual", "equal", "notEqual", "between", "notBetween"] },
        "values": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "fill": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
        "color": { "type": "string", "pattern": "^#[a-fA-F0-9]{6}$" },
        "stopIfTrue": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["fill"] }, { "required": ["color"] }],
      "if": { "properties": { "operator": { "enum": ["between", "notBetween"] } } },
      "then": { "properties": { "values": { "minItems": 2 } } },
      "else": { "properties": { "values": { "maxItems": 1 } } }
    },
    "worksheetChart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "config"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "config": {
          "$ref": "#/$defs/chartConfig"
        },
        "sourceMissing": {
          "type": "boolean"
        },
        "imported": {
          "type": "boolean"
        },
        "edited": {
          "type": "boolean"
        },
        "removed": {
          "type": "boolean"
        }
      }
    },
    "chartRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startRow",
        "endRow",
        "startColumn",
        "endColumn"
      ],
      "properties": {
        "startRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "endRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "chartConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "range",
        "anchorRow",
        "anchorColumn"
      ],
      "properties": {
        "kind": {
          "enum": [
            "column",
            "bar",
            "line",
            "pie"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "range": {
          "$ref": "#/$defs/chartRange"
        },
        "anchorRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "anchorColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        }
      }
    },
    "gridAutoFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startRow", "endRow", "startColumn", "endColumn", "column", "query"],
      "properties": {
        "startRow": { "type": "integer", "minimum": 1, "maximum": 1048575 },
        "endRow": { "type": "integer", "minimum": 2, "maximum": 1048576 },
        "startColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "endColumn": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "query": { "type": "string", "minLength": 1, "maxLength": 253 },
        "additionalCriteria": {
          "type": "array", "maxItems": 99,
          "items": { "$ref": "#/$defs/gridFilterCriterion" }
        }
      }
    },
    "gridFilterCriterion": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "query"],
      "properties": {
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "query": { "type": "string", "minLength": 1, "maxLength": 253 }
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part",
        "textOrdinal",
        "nodeKind",
        "editable"
      ],
      "properties": {
        "part": {
          "type": "string",
          "pattern": "^(word|xl|ppt|pdf|html|markdown|text|image)/"
        },
        "textOrdinal": {
          "type": "integer",
          "minimum": 1
        },
        "paragraphId": {
          "type": "string",
          "maxLength": 256
        },
        "sourceCellRef": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
        },
        "createdInHcd": {
          "type": "boolean"
        },
        "textId": {
          "type": "string",
          "maxLength": 256
        },
        "nodeKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "nodeMapEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "nodeHash",
        "source"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^n_[0-9a-f]{32}$"
        },
        "nodeHash": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/sourceAnchor"
        }
      }
    },
    "fidelityWarning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "nodeId": {
          "type": "string"
        },
        "sourcePart": {
          "type": "string"
        }
      }
    },
    "fidelityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "level",
        "preserved",
        "flattened",
        "dropped",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "hcd/2"
        },
        "level": {
          "enum": [
            "EXACT",
            "HIGH",
            "SEMANTIC",
            "VISUAL",
            "DEGRADED"
          ]
        },
        "preserved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "flattened": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fidelityWarning"
          }
        }
      }
    }
  }
}
