{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:55",
  "title": "HTML Canonical Document slide objects",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/55" },
    "documentId": { "$ref": "#/$defs/identifier" },
    "patchId": { "$ref": "#/$defs/identifier" },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string" } },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "oneOf": [{ "$ref": "#/$defs/insert" }, { "$ref": "#/$defs/transform" }] }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xEmu", "yEmu", "widthEmu", "heightEmu"],
      "properties": {
        "xEmu": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "yEmu": { "type": "integer", "minimum": 0, "maximum": 100000000 },
        "widthEmu": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "heightEmu": { "type": "integer", "minimum": 1, "maximum": 100000000 }
      }
    },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "insert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "chunkId", "preset", "geometry", "fill", "stroke"],
      "properties": {
        "op": { "const": "pptx.shape.insert" },
        "chunkId": { "$ref": "#/$defs/identifier" },
        "geometry": { "$ref": "#/$defs/geometry" },
        "preset": { "enum": ["rect", "roundRect", "ellipse"] },
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "chunkId", "objects"],
      "properties": {
        "op": { "const": "pptx.objects.transform" },
        "chunkId": { "$ref": "#/$defs/identifier" },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeId", "before", "geometry"],
            "properties": {
              "nodeId": { "type": "string", "pattern": "^n_[0-9a-f]{32}$" },
              "before": { "$ref": "#/$defs/geometry" },
              "geometry": { "$ref": "#/$defs/geometry" }
            }
          }
        }
      }
    }
  }
}
