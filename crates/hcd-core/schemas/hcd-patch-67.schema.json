{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "patchId",
    "baseRevision",
    "operations"
  ],
  "$id": "urn:officecli:hcd-patch:67",
  "title": "HCD merged table cell operations",
  "properties": {
    "schemaVersion": {
      "const": "hcd-patch/67"
    },
    "documentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "patchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/merge"
          },
          {
            "$ref": "#/$defs/split"
          }
        ]
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^n_[0-9a-f]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockHash"
      ],
      "properties": {
        "blockHash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "blockId",
        "tableIndex",
        "range",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "table.cells.merge"
        },
        "blockId": {
          "$ref": "#/$defs/nodeId"
        },
        "tableIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "precondition": {
          "$ref": "#/$defs/precondition"
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "row",
            "column",
            "rows",
            "columns"
          ],
          "properties": {
            "row": {
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "column": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            }
          }
        }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "blockId",
        "tableIndex",
        "row",
        "column",
        "precondition"
      ],
      "properties": {
        "op": {
          "const": "table.cell.split"
        },
        "blockId": {
          "$ref": "#/$defs/nodeId"
        },
        "tableIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9999
        },
        "precondition": {
          "$ref": "#/$defs/precondition"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      }
    }
  }
}
