{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:21",
  "title": "HTML Canonical Document XLSX formula creation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/21" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "maxLength": 65536 } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string", "maxLength": 262144 } },
    "operations": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/xlsxFormulaCreate" } }
  },
  "$defs": {
    "xlsxFormulaCreate": {
      "type": "object", "additionalProperties": false,
      "required": ["op", "sheetId", "row", "column", "formula"],
      "properties": {
        "op": { "const": "xlsx.formula.create" },
        "sheetId": { "type": "string", "pattern": "^s_[0-9a-f]{32}$" },
        "row": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "column": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "formula": { "type": "string", "minLength": 2, "maxLength": 8192, "pattern": "^=" }
      }
    }
  }
}
