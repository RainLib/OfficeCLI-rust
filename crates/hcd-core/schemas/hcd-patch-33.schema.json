{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:officecli:hcd-patch:33",
  "title": "HTML Canonical Document XLSX cell number format",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentId", "patchId", "baseRevision", "operations"],
  "properties": {
    "schemaVersion": { "const": "hcd-patch/33" },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "patchId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "actor": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string" } },
    "metadata": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "string" } },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["op", "nodeId", "numberFormat", "precondition"],
        "properties": {
          "op": { "const": "xlsx.cell.numberFormat" },
          "nodeId": { "type": "string", "pattern": "^n_[0-9a-f]{32}$" },
          "numberFormat": {
            "type": "object", "additionalProperties": false,
            "required": ["formatCode"],
            "properties": {
              "formatCode": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          },
          "precondition": {
            "type": "object", "additionalProperties": false,
            "required": ["nodeHash"],
            "properties": { "nodeHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          }
        }
      }
    }
  }
}
