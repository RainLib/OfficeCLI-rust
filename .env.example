# Local HTTP. For a public deployment, use an HTTPS origin and set the
# proxy site to the domain, the listen address to 0.0.0.0, and ports to 80/443.
FOLDLY_PUBLIC_URL=http://localhost:7400
FOLDLY_PROXY_SITE=:80
FOLDLY_LISTEN_ADDR=127.0.0.1
FOLDLY_HTTP_PORT=7400
FOLDLY_HTTPS_PORT=7443
FOLDLY_INTERNAL_PORT=7400

FOLDLY_IMAGE=foldly-workspace:0.1.33-local
FOLDLY_ADMIN=admin
FOLDLY_ADMIN_PASSWORD_FILE=./.secrets/foldly-admin-password

# PostgreSQL ships in the default stack. Prepare its passwords and connection
# file using docs/workspace-distribution.zh.md.
# To start MySQL instead, enable this Compose file list.
# COMPOSE_FILE=docker-compose.yaml:deploy/workspace/compose.mysql.yaml
# To use SQLite or a managed database, enable the following file list.
# COMPOSE_FILE=docker-compose.yaml:deploy/workspace/compose.external.yaml
# FOLDLY_DATABASE=sqlite
# For a managed database, set FOLDLY_DATABASE to postgres or mysql and configure
# FOLDLY_DATABASE_URL or FOLDLY_DATABASE_URL_FILE in the runtime env file.

# Use a separate runtime env file to configure an optional AI provider.
# FOLDLY_RUNTIME_ENV_FILE=./.foldly.runtime.env
# FOLDLY_SELECTION_MCP=false
