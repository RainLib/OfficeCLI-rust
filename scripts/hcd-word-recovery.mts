const base={revision:1,rootHash:revision.rootHash,layoutHash:projection.flowLayoutHash,digest:hash(seed.contents())},capsule=(model:WordRegionStore,userId:string)=>{const digest=hash(model.contents()),observation=model.document.getMap(imageDraftMap).size?hash(`${digest}:${hash(imageDraftContents(model.document))}`):digest;return wordSaveCapsule(journal().scope,model,base,[{userId,displayName:userId==='alice'?'Alice 王':'Bob 李',generation:1}],undefined,{observation,references:[]})},j=journal();await j.save(capsule(seed,'bob'),'none')
const fork=()=>{const model=make();Y.applyUpdate(model.document,Y.encodeStateAsUpdate(seed.document));return model},current=fork(),archive=fork(),edit=(model:WordRegionStore,region:string,text:string)=>{const before=model.region(region),block=before.find(entry=>entry.node.isTextblock)!;model.reconcile(region,before,before.map(entry=>entry===block?{key:entry.key,node:entry.node.type.createChecked(entry.node.attrs,schema.text(text,entry.node.firstChild?.marks))}:entry))}
const original=current.region(body).find(entry=>entry.node.isTextblock)!.node.textContent;edit(current,body,'Peer prefix '+original);edit(archive,body,original+' Recovered suffix 😀');edit(archive,header,'Recovered header 😀');edit(archive,footer,'Recovered footer 😀');const image=(await native('/images')).entries[0],images=new CollaborativeImageDraftStore(archive.document);images.edit(image,1,{...image.geometry,width:Math.round(image.geometry.width*.8)},undefined,'width');await j.save(capsule(current,'bob'),(await j.load())!.hash);const archiveId=await j.archiveSnapshot(capsule(archive,'alice'),'word-owner-lost')
if(c.preview){await writeFile(c.root+'/recovery-preview.json',JSON.stringify({archiveId,lineage})+'\n');docs.forEach(doc=>doc.destroy());process.exit(0)}
const log=await open(c.root+'/sidecar.log','a'),child=spawn(process.execPath,['--import','tsx','sidecar.ts'],{cwd:fileURLToPath(new URL('../examples/hdoc/editor/',import.meta.url)),env:{...process.env,HCD_API_URL:c.origin,HCD_COLLAB_PORT:String(c.collabPort),HCD_SIDECAR_STATE_DIR:stateRoot,HCD_TOKEN_SECRET:c.secret,HCD_WORD_ROOMS:'1'},stdio:['ignore',log.fd,log.fd]}),clients:HocuspocusProvider[]=[]
async function api(operation:string,extra:object={},token=c.bob){return fetch(`http://127.0.0.1:${c.collabPort}/v1/documents/rich/collaboration/word-recovery`,{method:'POST',headers:{Authorization:`Bearer ${token}`,'Content-Type':'application/json'},body:JSON.stringify({operation,epoch:1,...extra})})}
try{
 await until(async()=>{assert.equal(child.exitCode,null);try{return(await fetch(`http://127.0.0.1:${c.collabPort}`)).ok}catch{return false}},'sidecar listens')
 const list=await (await api('list',{},c.reader)).json();assert.equal(list.ready,false);assert.equal(list.canResolve,true);const preview=await (await api('preview',{archiveId,offset:0},c.reader)).json();assert.equal(preview.canMerge,true,JSON.stringify(preview));assert.ok(preview.proposedRows.some((row:any)=>row.after.includes('Peer prefix')&&row.after.includes('Recovered suffix')));assert.equal(preview.imageChanges,true)
 const request={requestId:randomUUID().replaceAll('-',''),archiveId,reviewHash:preview.reviewHash,action:'merge'},readOnly=await api('resolve',{choice:request},c.reader);assert.equal(readOnly.status,403)
 const copy=await (await api('download',{archiveId},c.reader)).json();assert.equal(copy.capsule.documentId,'rich');assert.equal(copy.capsule.actors[0].userId,'alice')
 let denied=false;const deniedDoc=new Y.Doc(),blocked=new HocuspocusProvider({url:`ws://127.0.0.1:${c.collabPort}?hcdNodeEdits=7&hcdWordRegions=1`,name:'rich:1:wordregions1:save5',token:c.bob,document:deniedDoc,WebSocketPolyfill:WebSocket,onClose:()=>{denied=true},onAuthenticationFailed:()=>{denied=true}});clients.push(blocked);await until(()=>denied,'unreviewed room blocked');blocked.destroy();deniedDoc.destroy()
 // A changed comparison must not acknowledge the archive. A member must view
 // the refreshed token before submitting a different request.
 await j.archiveSnapshot(capsule(seed,'bob'),'word-owner-expired');const stale=await api('resolve',{choice:request});assert.equal(stale.status,409);assert.equal((await stale.json()).code,'word-recovery-review-changed');assert.equal((await native('/revisions?limit=1')).headRevision,1)
 const fresh=await (await api('preview',{archiveId,offset:0})).json(),choice={...request,reviewHash:fresh.reviewHash},resolved=await api('resolve',{choice});assert.equal(resolved.status,200,await resolved.clone().text());assert.equal((await resolved.json()).idempotentReplay,false);const replay=await api('resolve',{choice});assert.equal(replay.status,200);assert.equal((await replay.json()).idempotentReplay,true);assert.equal((await (await api('list')).json()).ready,true)
 const doc=new Y.Doc(),model=new WordRegionStore(doc,schema,'rich',projection.flowLayout,projection.flowLayoutHash),provider=new HocuspocusProvider({url:`ws://127.0.0.1:${c.collabPort}?hcdNodeEdits=7&hcdWordRegions=1`,name:'rich:1:wordregions1:save5',token:c.bob,document:doc,WebSocketPolyfill:WebSocket});clients.push(provider);await until(()=>provider.isSynced&&doc.getMap(wordRegionStoreField).size>0&&!provider.hasUnsyncedChanges,'reviewed room joins');assert.match(model.project(body).textContent,/Peer prefix/);assert.match(model.project(body).textContent,/Recovered suffix/);assert.equal(model.region(body).find(entry=>entry.node.isTextblock)!.node.textContent,'Peer prefix '+original+' Recovered suffix 😀')
 const busy=await api('resolve',{choice});assert.equal(busy.status,409);assert.equal((await busy.json()).code,'word-recovery-room-active')
 const saved=await requestCoordinatedSave(provider,hash(model.contents()),undefined,30_000,await imageDraftDigest(doc));assert.equal(saved.status,'saved',JSON.stringify(saved));assert.equal(saved.revision,2);assert.equal(saved.pending,false);provider.destroy();doc.destroy()
 const record=await native('/revisions/2');assert.ok(record);assert.equal((await native(`/images/${image.nodeId}?revision=2`)).image.geometry.width,Math.round(image.geometry.width*.8));const report={scope:'Synthetic signed divergent snapshots; real production sidecar review API, native lease and regional WebSocket continuation; no legacy migration or production claim',head:2,comparisonIncludesPeerAndRecoveredInput:true,mergedPreviewIncludesBoth:true,readerCanInspectAndDownload:true,readerResolveStatus:403,unreviewedRoomBlocked:true,staleComparisonStatus:409,idempotentChoiceReplay:true,activeRoomDecisionStatus:409,originalAuthorProofRetained:true,archivedImageGeometrySaved:true,canonicalUnchangedByPrivateReview:true,archivesRetained:(await j.recoverySnapshots()).length,expected:{body:'Recovered suffix 😀',header:'Recovered header 😀',footer:'Recovered footer 😀'}};await writeFile(c.root+'/socket-evidence.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report))
}finally{clients.forEach(client=>client.destroy());docs.forEach(doc=>doc.destroy());child.kill('SIGTERM');await new Promise<void>(resolve=>{child.once('exit',()=>resolve());setTimeout(()=>{child.kill('SIGKILL');resolve()},6000).unref()});await log.close()}
