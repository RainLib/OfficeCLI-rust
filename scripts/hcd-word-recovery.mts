async function until(check:()=>boolean|Promise<boolean>,name:string){const deadline=Date.now()+30_000;while(Date.now()<deadline){if(await check())return;await pause(100)}throw new Error('Timeout: '+name)}
const projection=await native('/editor'),revision=await native('/revisions/1'),body=projection.flowLayout.sections[0].id,header=projection.flowLayout.stories.find((entry:any)=>entry.sourcePart==='word/header1.xml').id,footer=projection.flowLayout.stories.find((entry:any)=>entry.sourcePart==='word/footer2.xml').id,docs:Y.Doc[]=[],make=()=>{const doc=new Y.Doc();docs.push(doc);return new WordRegionStore(doc,schema,'rich',projection.flowLayout,projection.flowLayoutHash)},seed=make();seed.initialize(projection)
