/** Continues the exact draft chosen through the actual browser review. */
import assert from 'node:assert/strict'
import {readFile,writeFile} from 'node:fs/promises'
import {createHash,createHmac} from 'node:crypto'
import * as Y from '../examples/hdoc/editor/node_modules/yjs/dist/yjs.mjs'
import {HocuspocusProvider} from '../examples/hdoc/editor/node_modules/@hocuspocus/provider/dist/hocuspocus-provider.esm.js'
import {WordCheckpointJournal} from '../examples/hdoc/editor/src/wordCheckpointJournal.ts'
import {WordRegionStore,wordRegionSchema,wordRegionStoreField} from '../examples/hdoc/editor/src/wordRegionStore.ts'
import {imageDraftDigest} from '../examples/hdoc/editor/src/collaborativeImages.ts'
import {requestCoordinatedSave} from '../examples/hdoc/editor/src/semanticSaveClient.ts'
const c=JSON.parse(await readFile(process.argv[2],'utf8')),hash=(value:string)=>createHash('sha256').update(value).digest('hex'),lineage=createHmac('sha256',c.secret).update(`word-room/1:${c.origin}:rich:1`).digest('hex').slice(0,32),journal=new WordCheckpointJournal(c.root+'/shared-sidecar',c.origin,'rich',1,lineage,c.secret),privateState=(await journal.load())!
assert.equal(privateState.capsule.decisions!.length,1);assert.equal(privateState.capsule.decisions![0].userId,'bob');assert.equal(privateState.capsule.decisions![0].action,'merge');assert.deepEqual(new Set(privateState.capsule.actors.map(actor=>actor.userId)),new Set(['alice','bob']))
const headers={Authorization:`Bearer ${c.bob}`,'X-HCD-Flow-Layout-Version':'2','X-HCD-Collaboration-Epoch':'1','X-HCD-Collaboration-Protocol':'hcd-word-regions/1','X-HCD-Node-Edits-Version':'7','X-HCD-Custom-Marks-Version':'1'},json=async(route:string)=>{const response=await fetch(c.apiUrl+route,{headers});assert.equal(response.status,200);return response.json()},projection=await json('/editor'),headBefore=(await json('/revisions?limit=1')).headRevision;assert.equal(headBefore,1)
const doc=new Y.Doc(),model=new WordRegionStore(doc,wordRegionSchema(),'rich',projection.flowLayout,projection.flowLayoutHash),provider=new HocuspocusProvider({url:`ws://127.0.0.1:${c.collabPort}?hcdNodeEdits=7&hcdWordRegions=1`,name:'rich:1:wordregions1:save5',token:c.bob,document:doc,WebSocketPolyfill:WebSocket})
try{const deadline=Date.now()+30000;while(!provider.isSynced||!doc.getMap(wordRegionStoreField).size||provider.hasUnsyncedChanges){assert.ok(Date.now()<deadline);await new Promise(resolve=>setTimeout(resolve,100))}const body=projection.flowLayout.sections[0].id;assert.equal(model.region(body).find(entry=>entry.node.isTextblock)!.node.textContent,'Peer prefix Regional room intro. Recovered suffix 😀');const saved=await requestCoordinatedSave(provider,hash(model.contents()),undefined,30000,await imageDraftDigest(doc));assert.equal(saved.status,'saved',JSON.stringify(saved));assert.equal(saved.revision,2);assert.equal(saved.pending,false);const after=(await journal.load())!.capsule;assert.equal(after.decisions![0].requestId,privateState.capsule.decisions![0].requestId);assert.equal(after.base.revision,2);const report={scope:'Actual CUA browser merge choice, then real regional WebSocket save and native receipt; no default editor migration',head:2,privateReviewDidNotChangeCanonical:true,originalAuthors:['alice','bob'],reviewer:'bob',reviewDecisionPreservedAfterSave:true,exactBody:'Peer prefix Regional room intro. Recovered suffix 😀',header:'Recovered header 😀',footer:'Recovered footer 😀'};await writeFile(c.root+'/browser-saved.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify(report))}finally{provider.destroy();doc.destroy()}
