/** Real sidecar/native upload transport on an owned --rich-ui fixture. */
import assert from 'node:assert/strict'
import {readFile,writeFile} from 'node:fs/promises'
import {createHash,randomUUID} from 'node:crypto'
import {request as httpRequest} from 'node:http'
import * as Y from '../examples/hdoc/editor/node_modules/yjs/dist/yjs.mjs'
import {HocuspocusProvider} from '../examples/hdoc/editor/node_modules/@hocuspocus/provider/dist/hocuspocus-provider.esm.js'
import {WordRegionStore,wordRegionSchema,wordRegionStoreField} from '../examples/hdoc/editor/src/wordRegionStore.ts'
import {imageIntents,imageDraftDigest} from '../examples/hdoc/editor/src/collaborativeImages.ts'
import {requestCoordinatedSave} from '../examples/hdoc/editor/src/semanticSaveClient.ts'
const c=JSON.parse(await readFile(process.argv[2],'utf8')),protocol='hcd-word-regions/1',name='rich:1:wordregions1:save5',schema=wordRegionSchema(),url=`http://127.0.0.1:${c.collabPort}/v1/documents/rich/collaboration/word-uploads`,replacement=await readFile(c.root+'/replacement.png'),assetHash=createHash('sha256').update(replacement).digest('hex')
const pause=(ms:number)=>new Promise(resolve=>setTimeout(resolve,ms)),until=async(check:()=>boolean|Promise<boolean>,label:string)=>{const deadline=Date.now()+20000;while(Date.now()<deadline){if(await check())return;await pause(25)}throw new Error('Timeout: '+label)}
async function native(route:string){const response=await fetch(c.apiUrl+route,{headers:{Authorization:`Bearer ${c.reader}`,'X-HCD-Flow-Layout-Version':'2','X-HCD-Node-Edits-Version':'7'},signal:AbortSignal.timeout(15000)});assert.equal(response.status,200);return response.json()}
const initial=await native('/editor'),image=(await native('/images')).entries[0];assert.notEqual(image.assetHash,assetHash)
const clients:Array<{document:Y.Doc;provider:HocuspocusProvider;model:WordRegionStore}>=[]
async function connect(person:string){const document=new Y.Doc(),provider=new HocuspocusProvider({url:`ws://127.0.0.1:${c.collabPort}?hcdNodeEdits=7&hcdWordRegions=1`,name,document,token:c[person],WebSocketPolyfill:WebSocket}),model=new WordRegionStore(document,schema,'rich',initial.flowLayout,initial.flowLayoutHash);clients.push({document,provider,model});await until(()=>provider.isSynced&&!provider.hasUnsyncedChanges&&model.initialized,'fresh client');return clients.at(-1)!}
const headers=(person='bob',epoch=1)=>({Authorization:`Bearer ${c[person]}`,'X-HCD-Node-Edits-Version':'7','X-HCD-Collaboration-Epoch':String(epoch)})
async function api(body:object,person='bob',expected=200){const response=await fetch(url,{method:'POST',headers:{...headers(person),'Content-Type':'application/json'},body:JSON.stringify(body),signal:AbortSignal.timeout(30000)});const result=await response.json();assert.equal(response.status,expected,JSON.stringify(result));return result}
async function put(id:string,bytes:Uint8Array,person='bob',expected=200,epoch=1){const response=await fetch(url+'/'+id,{method:'PUT',headers:{...headers(person,epoch),'Content-Type':'application/octet-stream'},body:bytes,signal:AbortSignal.timeout(30000)});const result=await response.json();assert.equal(response.status,expected,JSON.stringify(result));return result}
function edit(client:typeof clients[number],region:string,text:string){const before=client.model.region(region),block=before.find(value=>value.node.isTextblock)!;client.model.reconcile(region,before,before.map(value=>value===block?{key:value.key,node:value.node.type.createChecked(value.node.attrs,schema.text(text,block.node.firstChild?.marks))}:value))}
try{
 const alice=await connect('alice'),bob=await connect('bob'),selection=()=>({id:randomUUID(),nodeId:image.nodeId,extension:'png',assetHash,byteLength:replacement.length,revision:initial.revision,clientId:bob.document.clientID,visualHash:image.visualHash,seen:[]})
 const cancelled=selection();await api({operation:'reserve',selection:cancelled});assert.equal((await native('/revisions?limit=1')).headRevision,initial.revision)
 edit(alice,initial.flowLayout.sections[0].id,'上传期间正文 Alice 😀');const footer=initial.flowLayout.stories.find((entry:any)=>entry.sourcePart==='word/footer2.xml').id;edit(bob,footer,'上传期间页脚 Bob');await until(()=>!alice.provider.hasUnsyncedChanges&&!bob.provider.hasUnsyncedChanges&&alice.model.contents()===bob.model.contents(),'input synchronized')
 const blocked=await requestCoordinatedSave(alice.provider,createHash('sha256').update(alice.model.contents()).digest('hex'),undefined,30000,await imageDraftDigest(alice.document));assert.equal(blocked.pending,true);assert.equal((await native('/revisions?limit=1')).headRevision,initial.revision)
 await api({operation:'resume',id:cancelled.id},'alice',404);assert.deepEqual((await api({operation:'list'},'alice')).records,[]);await put(cancelled.id,replacement,'reader',403);await put(cancelled.id,replacement,'bob',409,0)
 // Send a real half-body HTTP upload, cancel its durable choice, then finish the
 // old body. The late request must not stage or apply a replacement.
 let finishResponse!:(value:{status:number;body:any})=>void;const finished=new Promise<{status:number;body:any}>(resolve=>{finishResponse=resolve}),half=httpRequest(url+'/'+cancelled.id,{method:'PUT',headers:{...headers(),'Content-Type':'application/octet-stream','Content-Length':replacement.length}},response=>{let text='';response.on('data',chunk=>{text+=chunk});response.on('end',()=>finishResponse({status:response.statusCode!,body:JSON.parse(text)}))});half.on('error',error=>{throw error});half.write(replacement.subarray(0,Math.floor(replacement.length/2)));await pause(40);await api({operation:'cancel',id:cancelled.id});half.end(replacement.subarray(Math.floor(replacement.length/2)));assert.equal((await finished).status,409);assert.equal(imageIntents(bob.document).length,0)
 const completed=selection();await api({operation:'reserve',selection:completed});await put(completed.id,replacement);await until(()=>imageIntents(alice.document).some(entry=>entry.intentId===completed.id),'server-owned authored intent');const replay=await api({operation:'resume',id:completed.id});assert.equal(replay.record.phase,'applied');assert.equal(imageIntents(bob.document).filter(entry=>entry.intentId===completed.id).length,1)
 const result=await requestCoordinatedSave(alice.provider,createHash('sha256').update(alice.model.contents()).digest('hex'),undefined,30000,await imageDraftDigest(alice.document));assert.equal(result.status,'saved',JSON.stringify(result));assert.equal(result.pending,false);assert.equal((result as any).nodeEditVersion,7);const head=result.revision!;assert.equal((await native(`/images/${image.nodeId}?revision=${head}`)).image.assetHash,assetHash)
 await until(()=>!bob.provider.hasUnsyncedChanges,'saved state');const projection=await native(`/editor?revision=${head}`);await until(()=>clients.every(client=>client.document.getMap(wordRegionStoreField).get('layoutHash')===projection.flowLayoutHash),'layout receipt');for(const client of clients)client.model.syncLayout(projection.flowLayout,projection.flowLayoutHash)
 // Leave one durable, byte-less Bob choice for an actual browser to review.
 const pending=selection();pending.revision=head;pending.visualHash=(await native(`/images/${image.nodeId}?revision=${head}`)).image.visualHash;pending.assetHash=createHash('sha256').update(await readFile(c.root+'/recovery-original.png')).digest('hex');pending.byteLength=(await readFile(c.root+'/recovery-original.png')).length;await api({operation:'reserve',selection:pending});await api({operation:'resume',id:pending.id},'bob',409)
 const evidence={scope:'Actual production sidecar, native HTTP, two WebSocket members and half-body cancellation. Browser review follows separately.',head,body:'上传期间正文 Alice 😀',footer:'上传期间页脚 Bob',replacementHash:assetHash,originalHash:image.assetHash,imageId:image.nodeId,reservationBlockedNewCheckpoint:true,memberScopedReadAndWrite:true,readOnlyAndStaleEpochRejected:true,halfBodyCancelledBeforeLateCompletion:true,exactResumeAppliedOnce:true,pendingForBrowser:{id:pending.id,assetHash:pending.assetHash,byteLength:pending.byteLength,owner:'bob',file:c.root+'/recovery-original.png'}};await writeFile(c.root+'/upload-http-evidence.json',JSON.stringify(evidence,null,2)+'\n');console.log(JSON.stringify(evidence))
}finally{for(const client of clients){client.provider.destroy();client.document.destroy()}}
