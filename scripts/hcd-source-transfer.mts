const negotiated=await fetch(`http://127.0.0.1:${c.ports[1]}/v1/documents/mentions-docx/collaboration/negotiate`,{method:'POST',headers:{Authorization:'Bearer '+c.alice}});assert.equal(negotiated.status,200);const auth=await negotiated.json();assert.equal(auth.nodeEditVersion,6);const name=`mentions-docx:${auth.collaborationEpoch}:structure3:save4`,url=nodeEditCollaborationUrl(`ws://127.0.0.1:${c.ports[1]}`)
