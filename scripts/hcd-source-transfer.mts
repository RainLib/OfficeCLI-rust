async function save(client:any,revision:number){await until(()=>!client.provider.hasUnsyncedChanges,'ack');const result=await requestCoordinatedSave(client.provider,await checkpointDigest(jsonToSnapshot(client.store.project().toJSON())),undefined,45000,await imageDraftDigest(client.document));assert.equal(result.status,'saved',JSON.stringify(result));assert.equal(result.pending,false);assert.equal(result.revision,revision);const canonical=await info('/editor?revision='+revision),inlines=canonical.blocks.flatMap((block:any)=>block.content.inlines).filter((inline:any)=>inline.text.startsWith('Alpha')||inline.text.startsWith('Beta'));assert.equal(inlines.length,2);events.push({revision,result,sources:inlines.map((inline:any)=>({text:inline.text,id:inline.nodeId}))});await writeFile(c.root+`/transfer-r${revision}.bin`,Y.encodeStateAsUpdate(client.document),{mode:0o600});return canonical}
function change(client:any,mutate:(tr:any,doc:any)=>void,options={}){const doc=client.store.project(),state=EditorState.create({schema,doc,plugins:[sourceIdentityPlugin()]}),tr=state.tr;mutate(tr,doc);const next=state.applyTransaction(tr).state.doc;client.store.reconcile(client.store.blocks(),next.content.content.map((node:any)=>({key:node.attrs.hcdStructureKey,node})),options)}
let undo:Y.UndoManager|undefined
