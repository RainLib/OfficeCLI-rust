 assert.equal((await info()).revision,1);const alice=await connect('alice');alice.store.insert(['Alpha 中😀','Beta'].map(text=>schema.nodes.paragraph.createChecked(null,schema.text(text))),null);const baseline=await save(alice,2),alpha=alice.store.blocks().find((block:any)=>block.node.textContent.startsWith('Alpha')).key,beta=alice.store.blocks().find((block:any)=>block.node.textContent==='Beta').key,bob=await connect('bob');bob.provider.disconnect();await until(()=>bob.provider.configuration.websocketProvider.status==='disconnected','offline Bob');undo=alice.store.undoManager()
 change(alice,(tr,doc)=>{let at=-1;doc.descendants((node:any,position:number)=>{if(node.attrs.hcdStructureKey===beta)at=position});assert.ok(at>0);tr.join(at)},{textJoin:true});undo.stopCapturing();assert.equal(deletionReviews(alice.store).length,0);await save(alice,3)
 change(bob,(tr,doc)=>{let end=-1;doc.descendants((node:any,position:number)=>{if(node.attrs.hcdStructureKey===beta)end=position+1+node.content.size});assert.ok(end>0);tr.insertText(' · Bob late',end)});bob.provider.connect();await until(()=>bob.provider.isSynced&&alice.store.project().textContent.includes('Bob late'),'late input');await save(bob,4)
 for(const [direction,revision]of [['undo',5],['redo',6],['undo',7]] as const){assert.ok(undo[direction]());assert.equal(deletionReviews(alice.store).length,0);assert.match(alice.store.project().textContent,/Beta · Bob late/);await save(alice,revision);await until(()=>JSON.stringify(alice.store.project().toJSON())===JSON.stringify(bob.store.project().toJSON()),'exact peer projection')}
 const first=events[0].sources;for(const event of events){assert.equal(event.sources[0].id,first[0].id);assert.equal(event.sources[1].id,first[1].id);assert.equal(event.sources[0].text,'Alpha 中😀');assert.equal(event.sources[1].text,event.revision>=4?'Beta · Bob late':'Beta')}
 await writeFile(c.root+'/transfer-identities.json',JSON.stringify({alpha,beta,initialSourceIds:first.map((item:any)=>item.id),originalBlocks:baseline.blocks.slice(0,2)},null,2)+'\n',{mode:0o600});await writeFile(assets+'/transfer-socket.json',JSON.stringify({scope:'Actual production PM join, permanent-flow reconciliation, two authenticated sockets, late peer typing, guarded own undo/redo and native first saves.',events,head:7,allSourceIdsStable:true},null,2)+'\n');console.log('PASS real native join3, late input4, own undo5/redo6/undo7 preserve both source IDs and peer text')
}finally{undo?.destroy();for(const client of clients){client.provider.disconnect();client.provider.destroy();await client.provider.configuration.websocketProvider.destroy();client.document.destroy()}}
