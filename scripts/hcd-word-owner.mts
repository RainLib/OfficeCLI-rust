/** Multiple real processes, one canonical native root and shared private log.
 * Tokens/lease IDs remain private and are never emitted in evidence. */
import assert from 'node:assert/strict'
import {spawn,type ChildProcess} from 'node:child_process'
import {readFile,writeFile,open,mkdir,copyFile} from 'node:fs/promises'
import {fileURLToPath} from 'node:url'
import {createHash,createHmac,randomUUID} from 'node:crypto'
import {HocuspocusProvider} from '../examples/hdoc/editor/node_modules/@hocuspocus/provider/dist/hocuspocus-provider.esm.js'
import * as Y from '../examples/hdoc/editor/node_modules/yjs/dist/yjs.mjs'
import {WordRegionStore,wordRegionSchema,wordRegionStoreField} from '../examples/hdoc/editor/src/wordRegionStore.ts'
import {WordCheckpointJournal} from '../examples/hdoc/editor/src/wordCheckpointJournal.ts'
import {wordRecoveryStoreId} from '../examples/hdoc/editor/src/wordRoomLease.ts'
import {imageDraftDigest} from '../examples/hdoc/editor/src/collaborativeImages.ts'
import {requestCoordinatedSave} from '../examples/hdoc/editor/src/semanticSaveClient.ts'
const c=JSON.parse(await readFile(process.argv[2],'utf8')),schema=wordRegionSchema(),protocol='hcd-word-regions/1',room='rich:1:wordregions1:save5',stateRoot=c.root+'/shared-sidecar',log=await open(c.root+'/sidecar.log','a')
const pause=(ms:number)=>new Promise(resolve=>setTimeout(resolve,ms))
async function until(check:()=>boolean|Promise<boolean>,name:string,ms=25_000){const deadline=Date.now()+ms;while(Date.now()<deadline){if(await check())return;await pause(100)}throw new Error('Timeout: '+name)}
const headers={Authorization:`Bearer ${c['hcd-collaboration']}`,'Content-Type':'application/json','X-HCD-Flow-Layout-Version':'2','X-HCD-Node-Edits-Version':'7','X-HCD-Custom-Marks-Version':'1','X-HCD-Collaboration-Epoch':'1','X-HCD-Collaboration-Protocol':protocol,'X-HCD-Coordinator-Version':'5'}
async function api(route:string,init:RequestInit={},origin=c.origin){return fetch(origin+'/v1/documents/rich'+route,{...init,headers:{...headers,...init.headers},signal:AbortSignal.timeout(30_000)})}
async function json(route:string){const response=await api(route);assert.equal(response.status,200,await response.clone().text());return response.json()}
const initial=await json('/editor?revision=1'),body=initial.flowLayout.sections[0].id,header=initial.flowLayout.stories.find((story:any)=>story.sourcePart==='word/header1.xml').id,footer=initial.flowLayout.stories.find((story:any)=>story.sourcePart==='word/footer2.xml').id
const processes:ChildProcess[]=[],clients:Array<{document:Y.Doc;model:WordRegionStore;provider:HocuspocusProvider}>=[]
async function start(port:number,root=stateRoot){const child=spawn(process.execPath,['--import','tsx','sidecar.ts'],{cwd:fileURLToPath(new URL('../examples/hdoc/editor/',import.meta.url)),env:{...process.env,HCD_API_URL:c.origin,HCD_COLLAB_PORT:String(port),HCD_SIDECAR_STATE_DIR:root,HCD_TOKEN_SECRET:c.secret,HCD_WORD_ROOMS:'1'},stdio:['ignore',log.fd,log.fd]});processes.push(child);await until(async()=>{assert.equal(child.exitCode,null);try{return(await fetch(`http://127.0.0.1:${port}`,{signal:AbortSignal.timeout(500)})).ok}catch{return false}},'sidecar starts');return child}
async function stop(child:ChildProcess){if(child.exitCode!==null||child.signalCode!==null)return;child.kill('SIGCONT');child.kill('SIGTERM');await new Promise<void>(resolve=>{child.once('exit',()=>resolve());setTimeout(()=>{if(child.exitCode===null&&child.signalCode===null)child.kill('SIGKILL')},5000).unref()})}
function client(port:number){let closed=0;const document=new Y.Doc(),model=new WordRegionStore(document,schema,'rich',initial.flowLayout,initial.flowLayoutHash),provider=new HocuspocusProvider({url:`ws://127.0.0.1:${port}?hcdNodeEdits=7&hcdWordRegions=1`,name:room,token:c.bob,document,WebSocketPolyfill:WebSocket,onClose:()=>{closed++},onAuthenticationFailed:()=>{closed++}});const value={document,model,provider,get closed(){return closed}};clients.push(value);return value}
async function ready(value:ReturnType<typeof client>){await until(()=>value.provider.isSynced&&value.document.getMap(wordRegionStoreField).size>0&&!value.provider.hasUnsyncedChanges,'client ready')}
function edit(value:ReturnType<typeof client>,region:string,text:string){const before=value.model.region(region),block=before.find(node=>node.node.isTextblock)!;value.model.reconcile(region,before,before.map(node=>node===block?{key:node.key,node:node.node.type.createChecked(node.node.attrs,schema.text(text,block.node.firstChild?.marks))}:node))}
const lineage=createHmac('sha256',c.secret).update(`word-room/1:${c.origin}:rich:1`).digest('hex').slice(0,32),journal=()=>new WordCheckpointJournal(stateRoot,c.origin,'rich',1,lineage,c.secret)
try{
 const first=await start(c.collabPort),a=client(c.collabPort);await ready(a);edit(a,body,'Unsubmitted draft before owner pause 😀');edit(a,header,'Header retained across owner handoff 😀');edit(a,footer,'Footer retained across owner handoff 😀');await until(()=>!a.provider.hasUnsyncedChanges,'typed content synced')
 await until(async()=>{const saved=await journal().load();if(!saved)return false;const doc=new Y.Doc();try{Y.applyUpdate(doc,Buffer.from(saved.capsule.document,'base64'));const model=new WordRegionStore(doc,schema,'rich',initial.flowLayout,saved.capsule.base.layoutHash);return model.project(body).textContent.includes('Unsubmitted draft')}finally{doc.destroy()}},'unsubmitted draft durably journaled')
 assert.equal((await json('/revisions?limit=1')).headRevision,1)
 const storeId=await wordRecoveryStoreId(stateRoot,c.origin,c.secret),rawOwner=randomUUID().replaceAll('-','')
 const lease=async(action:string,store=storeId,leaseId?:string,token=c['hcd-collaboration'])=>{const known=journal();await known.load();return api('/collaboration/word-owner',{method:'POST',headers:{Authorization:`Bearer ${token}`},body:JSON.stringify({version:1,epoch:1,ownerId:rawOwner,storeId:store,action,journalHashes:known.knownHashes(),...(leaseId?{leaseId}:{})})},c.secondOrigin)}
 assert.equal((await lease('acquire',storeId,undefined,c.bob)).status,403)
 assert.equal((await lease('acquire')).status,409,'second native process must see the OS lock')
 const second=await start(c.standbyPort),blocked=client(c.standbyPort);await until(()=>blocked.closed>0,'second sidecar refused while first active');assert.equal(blocked.provider.isSynced,false);blocked.provider.destroy()
 first.kill('SIGSTOP');const pauseStart=Date.now();let temporary:any
 await until(async()=>{const response=await lease('acquire');if(response.status===409)return false;assert.equal(response.status,200,await response.clone().text());temporary=await response.json();return true},'native expiry releases old OS lock',25_000)
 const expiryWaitMs=Date.now()-pauseStart;assert.ok(expiryWaitMs>=10_000);assert.equal(first.exitCode,null);assert.equal((await lease('release',storeId,temporary.leaseId)).status,200)
 const b=client(c.standbyPort);await ready(b);assert.match(b.model.project(body).textContent,/Unsubmitted draft before owner pause/);assert.equal((await json('/revisions?limit=1')).headRevision,1)
 first.kill('SIGCONT');await until(()=>a.closed>0,'resumed expired owner closes old clients');await until(async()=>Boolean((await journal().recoverySnapshots()).length),'old owner archived its frozen snapshot')
 // Keep the new room alive beyond a full native TTL. A contender through a
 // different native process must still be fenced after real renewals.
 await pause(17_000);assert.equal((await lease('acquire')).status,409)
 edit(b,body,'Saved by new fenced owner 😀');await until(()=>!b.provider.hasUnsyncedChanges,'new owner edit synced');const saved=await requestCoordinatedSave(b.provider,createHash('sha256').update(b.model.contents()).digest('hex'),undefined,30_000,await imageDraftDigest(b.document));assert.equal(saved.status,'saved',JSON.stringify(saved));assert.equal(saved.pending,false)
 b.provider.destroy();await stop(second);assert.equal(second.exitCode,0,'graceful stop drains and releases')
 const wrongStore='d'.repeat(32),wrong=await lease('acquire',wrongStore);assert.equal(wrong.status,409);assert.match((await wrong.json()).error,/store-mismatch/)
 const third=await start(c.wrongStorePort,c.root+'/wrong-sidecar'),wrongClient=client(c.wrongStorePort);await until(()=>wrongClient.closed>0,'different private store refused');assert.equal(wrongClient.provider.isSynced,false);wrongClient.provider.destroy();await stop(third)
 const copiedRoot=c.root+'/copied-identity-sidecar',identityPath=createHash('sha256').update(c.origin).digest('hex')+'/word-room-store/identity.json';await mkdir(copiedRoot+'/'+identityPath.slice(0,identityPath.lastIndexOf('/')),{recursive:true});await copyFile(stateRoot+'/'+identityPath,copiedRoot+'/'+identityPath)
 const copied=await start(c.wrongStorePort,copiedRoot),copiedClient=client(c.wrongStorePort);await until(()=>copiedClient.closed>0,'copied store identity without journal refused');assert.equal(copiedClient.provider.isSynced,false);copiedClient.provider.destroy();await stop(copied)
 const missing=await api('/collaboration/word-owner',{method:'POST',body:JSON.stringify({version:1,epoch:1,ownerId:rawOwner,storeId,action:'acquire',journalHashes:['none']})},c.secondOrigin);assert.equal(missing.status,409);assert.match((await missing.json()).error,/chain-missing/)
 const acquired=await lease('acquire');assert.equal(acquired.status,200);const currentLease=await acquired.json(),projection=await json('/editor'),doc=new Y.Doc(),model=new WordRegionStore(doc,schema,'rich',projection.flowLayout,projection.flowLayoutHash);model.initialize(projection)
 const payload=()=>({coordinatorVersion:5,coordinatorId:lineage,checkpointId:randomUUID().replaceAll('-',''),coordinatorDigest:createHash('sha256').update(model.contents()).digest('hex'),expectedRevision:projection.revision,layoutHash:projection.flowLayoutHash,typographyVersion:2,extensionVersion:1,referenceVersion:1,regions:model.capture().regions.map(region=>({...region,images:[]})),contributors:[{userId:'bob',displayName:'Bob'}]})
 assert.equal((await api('/word/checkpoints',{method:'POST',body:JSON.stringify(payload())},c.secondOrigin)).status,409,'missing owner header cannot publish')
 const ownerHeaders={'X-HCD-Word-Owner':currentLease.leaseId,'X-HCD-Word-Owner-Id':rawOwner,'X-HCD-Word-Journal-Hash':currentLease.journalHash},valid=await api('/word/checkpoints',{method:'POST',headers:ownerHeaders,body:JSON.stringify(payload())},c.secondOrigin);assert.equal(valid.status,200,await valid.clone().text());assert.equal((await valid.json()).revision,projection.revision)
 assert.equal((await lease('release',storeId,currentLease.leaseId)).status,200)
 const before=model.region(body),block=before[0];model.reconcile(body,before,before.map(node=>node===block?{key:node.key,node:node.node.type.createChecked(node.node.attrs,schema.text('STALE OWNER MUST NOT COMMIT',node.node.firstChild?.marks))}:node));const denied=await api('/word/checkpoints',{method:'POST',headers:ownerHeaders,body:JSON.stringify(payload())},c.secondOrigin);assert.equal(denied.status,409);doc.destroy();const head=(await json('/revisions?limit=1')).headRevision;assert.equal(head,projection.revision)
 const evidence={scope:'Two native processes sharing one local root and four actual sidecar processes; not remote database/S3 or cross-host filesystem certification',head,simultaneousSidecarRefused:true,secondNativeRespectedOsLock:true,suspendedOldProcessRemainedAlive:true,nativeExpiryWaitMs:expiryWaitMs,unsubmittedSignedDraftRecoveredByNewOwner:true,expiredOldOwnerClosedClients:true,frozenSnapshotArchived:true,renewalBeyondNativeTtlVerified:true,gracefulOwnerDrainAndRelease:true,differentPrivateStoreRefused:true,copiedStoreIdentityWithoutJournalRefused:true,missingRequiredJournalAncestryStatus:409,memberCannotAcquireOwner:true,missingOwnerCheckpointStatus:409,releasedOwnerCheckpointStatus:denied.status,canonicalHeadUnchangedByStaleOwner:true,sidecars:[first.pid,second.pid,third.pid,copied.pid],expected:{body:'Saved by new fenced owner 😀',header:'Header retained across owner handoff 😀',footer:'Footer retained across owner handoff 😀'}}
 await writeFile(c.root+'/socket-evidence.json',JSON.stringify(evidence,null,2)+'\n');console.log(JSON.stringify(evidence))
}finally{for(const value of clients){value.provider.destroy();value.document.destroy()}for(const child of processes)await stop(child);await log.close()}
