import { createHash } from "node:crypto";
import { check, type DatabaseKind } from "./contracts.mts";
import type { DatabaseConnection, DatabaseParameter, DatabaseRow } from "./database.mts";

export const workspaceSchemaVersion = "officecli-workspace/1";
const workspaceSchemaRevision = "1";

export const identifier = (name: string) => '"' + name.replaceAll('"', '""') + '"';

// SQLite NOCASE only folds ASCII. Preserve existing folder names, including
// pairs that differ only by the case of a non-ASCII character.
export function foldName(kind: DatabaseKind, field: string) {
  if (kind === "sqlite") return `LOWER(${field})`;
  if (kind === "postgres") return `LOWER(${field} COLLATE "C")`;
  return [..."ABCDEFGHIJKLMNOPQRSTUVWXYZ"].reduce(
    (sql, letter) => `REPLACE(${sql},'${letter}','${letter.toLowerCase()}')`, field,
  );
}

function tables(kind: DatabaseKind) {
  const mysql = kind === "mysql";
  const text = mysql ? "LONGTEXT" : kind === "postgres" ? 'TEXT COLLATE "C"' : "TEXT";
  const string = (size: number) => mysql ? `VARCHAR(${size})` : text;
  const required = (type: string) => type + " NOT NULL";
  const number = kind === "sqlite" ? "INTEGER" : "BIGINT";
  const integer = required(number);
  const flag = "INTEGER NOT NULL DEFAULT 0";
  const id = required(string(36));
  const digest = required(string(64));
  const time = required(string(24));
  const payload = required(text);
  const name = required(string(255));
  const oneOf = (field: string, values: string) => `${required(string(24))} CHECK (${field} IN (${values}))`;
  const foreign = (field: string, target: string) => `FOREIGN KEY (${field}) REFERENCES ${target}(id)`;
  const user = (field: string) => foreign(field, "users");
  const file = (field = "file_id") => foreign(field, "files");
  const project = foreign("project_id", "projects");
  const folder = (field: string) => `FOREIGN KEY (${field},project_id) REFERENCES project_folders(id,project_id)`;
  const order = kind === "sqlite" ? "INTEGER PRIMARY KEY AUTOINCREMENT" : mysql
    ? "BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY" : "BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY";
  const audit = { name: "audit", key: ["id"], columns: {
    id: order, actor_id: string(36), action: required(string(96)), target_id: string(64), created_at: time,
  }, constraints: [] };
  const table = (name: string, key: string[], columns: Record<string, string>, ...constraints: string[]) =>
    ({ name, key, columns, constraints: [`PRIMARY KEY (${key.map(identifier).join(",")})`, ...constraints] });

  return [
    table("metadata", ["key"], { key: required(string(128)), value: payload }),
    table("users", ["id"], {
      id, username: required(string(64)), display_name: name, password: payload,
      role: oneOf("role", "'admin','member'"), disabled: flag, created_at: time,
    }, "UNIQUE (username)"),
    table("sessions", ["hash"], { hash: digest, user_id: id, csrf: digest, expires: integer, created: integer }, user("user_id")),
    table("files", ["id"], {
      id, name, format: required(string(24)), media_type: required(string(128)), owner_id: id,
      head: integer, created_at: time, modified_at: time,
    }, user("owner_id")),
    table("versions", ["file_id", "version"], {
      file_id: id, version: integer, sha256: digest, size: integer, actor_id: id, created_at: time, receipt: text,
    }, file(), user("actor_id")),
    table("acl", ["file_id", "user_id"], { file_id: id, user_id: id, profile: required(string(24)), operations: payload }, file(), user("user_id")),
    table("launches", ["id"], {
      id, browser_hash: digest, user_id: id, file_id: id, expires: integer, closed: flag, response: text, request: text,
      purpose: required(string(24)) + " DEFAULT 'open'",
    }, user("user_id"), file()),
    table("exchanges", ["id"], {
      id, session_id: id, credential_hash: digest, purpose: required(string(24)), result: payload,
    }, foreign("session_id", "launches")),
    table("publications", ["id"], {
      id, file_id: id, actor_id: id, intent: payload, uploaded: flag, receipt: text, created_at: time,
    }, file(), user("actor_id")),
    table("events", ["id"], {
      id, file_id: id, sequence: integer, type: required(string(96)), body: payload, received_at: time,
    }, file()),
    table("nonces", ["id"], { id, expires: integer }),
    table("workbench_jobs", ["id"], { id, owner_id: id, created_at: integer, state: payload }, user("owner_id")),
    table("login_attempts", ["key"], { key: digest, failures: integer, reset_at: integer }),
    audit,
    table("shares", ["file_id"], {
      file_id: id, visibility: oneOf("visibility", "'private','link','public'"),
      permission: oneOf("permission", "'read','write'"), secret_hash: digest, secret_cipher: payload,
      generation: integer, expires: number, updated_at: time,
    }, file()),
    table("guest_identities", ["user_id"], { user_id: id, expires: integer }, user("user_id")),
    table("share_grants", ["user_id", "file_id"], {
      user_id: id, file_id: id, generation: integer, expires: integer,
    }, "FOREIGN KEY (user_id) REFERENCES guest_identities(user_id)", file()),
    table("projects", ["id"], { id, name, owner_id: id, created_at: time }, user("owner_id")),
    table("project_members", ["project_id", "user_id"], {
      project_id: id, user_id: id, role: oneOf("role", "'manager','editor','viewer'"),
    }, project, user("user_id")),
    table("project_folders", ["id"], {
      id, project_id: id, parent_id: string(36), name: required(string(80)),
    }, project, "UNIQUE (id,project_id)", folder("parent_id")),
    table("project_files", ["file_id"], { file_id: id, project_id: id, folder_id: string(36) }, file(), project, folder("folder_id")),
    table("canvas_mention_heads", ["file_id"], { file_id: id, revision: integer }, file()),
    table("canvas_mentions", ["id"], {
      id, file_id: id, element_id: required(string(256)), recipient: required(string(256)),
      kind: required(string(32)), preview: payload, received_at: time, read_at: string(24),
    }, file(), "UNIQUE (file_id,element_id,recipient)"),
    table("publication_copies", ["publication_id"], { publication_id: id, file_id: id }, file()),
  ];
}

function schemaStatements(kind: DatabaseKind) {
  const mysql = kind === "mysql";
  const folderNames = kind === "sqlite"
    ? "project_id,COALESCE(parent_id,''),name COLLATE NOCASE"
    : `project_id,(COALESCE(parent_id,'')),(${foldName(kind, "name")})`;
  const indexes = [
    { table: "workbench_jobs", name: "workbench_jobs_owner", keys: "owner_id,created_at DESC" },
    { table: "launches", name: "launches_browser", keys: "browser_hash" },
    { table: "launches", name: "launches_imported_file", keys: "file_id", where: "response IS NOT NULL" },
    { table: "sessions", name: "sessions_user", keys: "user_id" },
    { table: "project_members", name: "project_members_user", keys: "user_id,project_id" },
    { table: "project_folders", name: "project_folder_names", keys: folderNames, unique: true },
    { table: "project_files", name: "project_files_location", keys: "project_id,folder_id" },
    { table: "canvas_mentions", name: "canvas_mentions_recipient", keys: "recipient,received_at DESC,id DESC" },
  ];
  const ddl = tables(kind).map(({ name, columns, constraints }) => {
    const fields = Object.entries(columns).map(([field, type]) => `${identifier(field)} ${type}`);
    const keys = mysql ? indexes.filter(index => index.table === name)
      .map(index => `${index.unique ? "UNIQUE KEY" : "KEY"} ${index.name} (${index.keys})`) : [];
    return `CREATE TABLE IF NOT EXISTS ${name} (\n  ${[...fields, ...constraints, ...keys].join(",\n  ")}\n)` +
      (mysql ? " ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_bin" : "");
  });
  if (mysql) return ddl;
  return [...ddl, ...indexes.map(index => `CREATE ${index.unique ? "UNIQUE " : ""}INDEX IF NOT EXISTS ${index.name} ON ${index.table}(${index.keys})` +
    (index.where ? ` WHERE ${index.where}` : ""))];
}

const versionKey = "schemaVersion";
const revisionKey = "schemaRevision";
export const bindingKey = "workspaceId";
const schemaVersions = [versionKey, revisionKey];

export async function verifySchema(db: DatabaseConnection, legacy = false) {
  const rows = await db.all('SELECT "key",value FROM metadata', []);
  const values = new Map(rows.map(row => [row.key, row.value]));
  const compatible = (key: string, value: string) => legacy && !values.has(key) || values.get(key) === value;
  check(compatible(versionKey, workspaceSchemaVersion) && compatible(revisionKey, workspaceSchemaRevision),
    503, "业务库版本不兼容，请使用对应版本恢复。");
  return values;
}

export async function createSchema(db: DatabaseConnection) {
  for (const statement of schemaStatements(db.kind)) await db.exec(statement);
  const versions = await verifySchema(db, true);
  for (const [key, value] of [[versionKey, workspaceSchemaVersion], [revisionKey, workspaceSchemaRevision]]) {
    if (!versions.has(key)) await db.run("INSERT INTO metadata VALUES(?,?)", [key, value]);
  }
}

export async function verifyEmptySchema(db: DatabaseConnection, existingNames: unknown[]) {
  const definitions = tables(db.kind);
  check(!existingNames.length || existingNames.length === definitions.length &&
    definitions.every(({ name }) => existingNames.includes(name)), 409, "目标数据库需要空的专用库或未导入数据的工作区库。");
  const metadata = await verifySchema(db);
  check(metadata.size === schemaVersions.length, 409, "目标数据库已初始化，请使用空的专用数据库。");
  for (const { name } of definitions) {
    if (name === "metadata") continue;
    check(!(await db.all(`SELECT 1 FROM ${name} LIMIT 1`, [])).length, 409, "目标数据库中已有工作区数据。");
  }
}

function projection(kind: DatabaseKind) {
  return tables(kind).map(({ name, key, columns }) => ({
    name,
    columns: Object.keys(columns).map(identifier),
    keys: key.map(identifier),
  }));
}

async function* batches(db: DatabaseConnection, table: ReturnType<typeof projection>[number], signal: AbortSignal) {
  const folders = table.name === "project_folders";
  const keys = folders ? ["tree.depth", "f.id"] : table.keys;
  const rowKeys = folders ? ["folder_depth", "id"] : table.keys.map(key => key.slice(1, -1));
  const order = keys.join(",");
  const base = folders
    ? `WITH RECURSIVE tree(folder_id,depth) AS (
        SELECT id,0 FROM project_folders WHERE parent_id IS NULL
        UNION ALL SELECT f.id,tree.depth+1 FROM project_folders f JOIN tree ON f.parent_id=tree.folder_id
      ) SELECT ${table.columns.map(column => "f." + column).join(",")},tree.depth AS folder_depth
        FROM project_folders f JOIN tree ON tree.folder_id=f.id`
    : `SELECT ${table.columns.join(",")} FROM ${table.name}`;
  const placeholders = keys.map(() => "?").join(",");
  const afterClause = keys.length === 1 ? ` WHERE ${order}>?` : ` WHERE (${order})>(${placeholders})`;
  const limit = 64;
  let after: DatabaseParameter[] = [];
  while (true) {
    signal.throwIfAborted();
    const rows = await db.all(base + (after.length ? afterClause : "") + ` ORDER BY ${order} LIMIT ?`, [...after, limit]);
    if (rows.length) yield rows;
    if (rows.length < limit) break;
    after = rowKeys.map(key => {
      const value = rows.at(-1)![key];
      check(typeof value === "string" || typeof value === "number", 409, "业务库主键无法迁移。");
      return value;
    });
  }
}

function recordDigest(hash: ReturnType<typeof createHash>, row: DatabaseRow, columns: string[]) {
  const values = columns.map(column => row[column.slice(1, -1)]);
  check(values.every(value => value === null || typeof value === "string" || Number.isSafeInteger(value)),
    409, "业务库包含无法迁移的字段。");
  hash.update(JSON.stringify(values)).update("\n");
  return values as DatabaseParameter[];
}

// Copy in foreign-key order, then read the destination back before its
// transaction commits. The binding is created separately by the new root.
export async function copyBusinessRows(source: DatabaseConnection, target: DatabaseConnection, signal: AbortSignal) {
  await verifySchema(source);
  for (const table of projection(source.kind)) {
    if (table.name === "metadata") continue;
    const sent = createHash("sha256"), received = createHash("sha256");
    let copied = 0;
    for await (const rows of batches(source, table, signal)) {
      const values = rows.map(row => recordDigest(sent, row, table.columns));
      const parameters = "(" + table.columns.map(() => "?").join(",") + ")";
      await target.run(`INSERT INTO ${table.name} (${table.columns.join(",")}) VALUES ${values.map(() => parameters).join(",")}`, values.flat());
      copied += rows.length;
    }
    if (table.name === "project_folders") {
      const [count] = await source.all("SELECT COUNT(*) AS total FROM project_folders", []);
      check(count.total === copied, 409, "项目目录含有无法迁移的父子关系。");
    }
    for await (const rows of batches(target, table, signal)) {
      for (const row of rows) recordDigest(received, row, table.columns);
    }
    check(sent.digest("hex") === received.digest("hex"), 409, `业务数据库表 ${table.name} 迁移校验失败。`);
  }
  if (target.kind === "postgres") {
    await target.all(`SELECT setval(pg_get_serial_sequence('audit','id'), COALESCE(MAX(id),1), MAX(id) IS NOT NULL) FROM audit`, []);
  }
}
